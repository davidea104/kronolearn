# Example environment variables for local development and baseline deployment
# Do NOT commit secrets. Use this as a template and copy to .env for local dev.

SECRET_KEY=replace-me-with-a-secure-key
DEBUG=True
DATABASE_URL=postgresql://user:password@localhost:5432/kronolearn_db
DJANGO_SETTINGS_MODULE=kronolearn.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1
RAILWAY_ENV=development
RAY_DEPLOYMENT_NAME=kronolearn-web
CONTENT_AUTHOR_ACCOUNT_ID=

# Optional third-party credentials (placeholders)
# SENTRY_DSN=
# RAILWAY_API_KEY=
